{
  "name": "magein/migration",
  "type": "library",
  "description": "基于phinx重新封装的面向对象形式的数据库迁移类",
  "keywords": [
    "php",
    "phinx",
    "migration"
  ],
  "homepage": "https://gitee.com/magein/php-migration",
  "license": "MIT",
  "autoload": {
    "files": [
      "phinx/str.php"
    ],
    "psr-4": {
      "magein\\migration\\": "src/",
      "Phinx\\": "phinx/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "tests\\": "tests/"
    }
  },
  "authors": [
    {
      "name": "magein",
      "email": "1154699897@qq.com"
    }
  ],
  "require": {
    "php": "^7.4",
    "ext-pdo": "*"
  },
  "require-dev": {
    "phpunit/phpunit": "^9.6"
  },
  "scripts": {
    "test": "phpunit"
  },
  "bin": [
    "bin/migrate"
  ]
}