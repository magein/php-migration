#!/usr/bin/env php
<?php

$__autoload = [
    dirname(__DIR__, 3) . '/autoload.php',
    dirname(__DIR__) . '/autoload.php',
    dirname(__DIR__) . '/vendor/autoload.php',
];

foreach ($__autoload as $file) {
    if (file_exists($file)) {
        define('MIGRATION_COMPOSER_INSTALL_COMPLETED', $file);
        break;
    }
}

// 三个候选路径都不存在时不进 require，避免引用未定义常量导致不可读的 Fatal error
if (!defined('MIGRATION_COMPOSER_INSTALL_COMPLETED')) {
    fwrite(STDERR, '未找到 composer 的 autoload.php，请先执行 composer install' . PHP_EOL);
    exit(1);
}

require MIGRATION_COMPOSER_INSTALL_COMPLETED;

$input = new \magein\migration\PhinxInput();
$app = new \Phinx\Console\PhinxApplication();

try {
    exit($app->run($input->init()));
} catch (\InvalidArgumentException $e) {
    // PhinxInput 的参数校验错误在进入 Phinx 之前拦截，避免输出未捕获异常的调用栈
    fwrite(STDERR, '参数错误：' . $e->getMessage() . PHP_EOL);
    exit(1);
}